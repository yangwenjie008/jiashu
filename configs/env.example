# 数据库配置模板
# 复制此文件为 .env 并填入实际配置

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=jiashu
DB_PASSWORD=your_password_here
DB_NAME=jiashu
DB_SSLMODE=disable

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=jiashu

# JWT配置
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

# 应用配置
APP_PORT=8080
APP_MODE=development
LOG_LEVEL=debug
